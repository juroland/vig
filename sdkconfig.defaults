    # This file was generated using idf.py save-defconfig. It can be edited manually.
    # Espressif IoT Development Framework (ESP-IDF) 6.0.1 Project Minimal Configuration
    #
    # default:
CONFIG_IDF_TARGET="esp32p4"
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
CONFIG_ESPTOOLPY_FLASHSIZE_32MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_VIGO_MOTION_THRESHOLD=25
CONFIG_VIGO_MOTION_MIN_CHANGE_RATIO=0.05
CONFIG_VIGO_PEDESTRIAN_MAX_AREA_PROPORTION=0.7
CONFIG_VIGO_PEDESTRIAN_MIN_ASPECT_RATIO=0.0
CONFIG_VIGO_PEDESTRIAN_MAX_ASPECT_RATIO=0.0
CONFIG_VIGO_PEDESTRIAN_CLASSIFICATION_THRESHOLD=0.70
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_CAM_CTLR_MIPI_CSI_ISR_CACHE_SAFE=y
CONFIG_HTTPD_WS_SUPPORT=y
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_ESP32P4_REV_MIN_100=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_XIP_FROM_PSRAM=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=1024
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=262144
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_ESP_TASK_WDT_TIMEOUT_S=20
CONFIG_ESP_HOST_WIFI_ENABLED=n
CONFIG_ESP_WIFI_REMOTE_ENABLED=y
CONFIG_LOG_COLORS=y
CONFIG_LWIP_MAX_SOCKETS=16
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=16384
CONFIG_LWIP_TCP_WND_DEFAULT=16384
CONFIG_MBEDTLS_SSL_PROTO_DTLS=y
CONFIG_MBEDTLS_SSL_DTLS_SRTP=y
CONFIG_CAMERA_OV5647=y
CONFIG_CAMERA_OV5647_MIPI_RAW10_1280X960_BINNING_45FPS=y
CONFIG_CAMERA_OV5647_MIPI_DEFAULT_FMT_RAW10_1280X960_BINNING_45FPS=y
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=4
CONFIG_ESP_WIFI_DYNAMIC_RX_MGMT_BUFFER=y
CONFIG_ESP_WIFI_RX_MGMT_BUF_NUM_DEF=16
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_360=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ=360

# Move Wi-Fi remote stack (ESP-Hosted) default tasks and memory pool to PSRAM
CONFIG_ESP_HOSTED_DFLT_TASK_FROM_SPIRAM=y
CONFIG_ESP_HOSTED_MEMPOOL_PREFER_SPIRAM=y

# Do NOT auto-init ESP-Hosted before app_main(): the boot-time probing task
# fights the SD card over the shared SDMMC host controller in USB mass storage
# mode and latches BRINGUP_FAILED before the app even gets to init WiFi.
# The co-processor link is brought up on demand in init_wifi() instead.
CONFIG_ESP_HOSTED_AUTO_CALL_INIT_BEFORE_APP_MAIN=n

# Co-processor reset polarity on GPIO54. ESP modules' EN pin is active-LOW by
# convention (LOW = reset, HIGH = run); esp_hosted 2.x-era configs on this
# project drifted to ACTIVE_HIGH which would hold the C6 in permanent reset
# (CP never answers send_op_cond → sdmmc 0x107 timeouts) if GPIO54 is wired
# straight to EN. Keep LOW unless the board has an inverting buffer on EN.
CONFIG_ESP_HOSTED_SDIO_RESET_ACTIVE_LOW=y

# USB Mass Storage mode on the SD card (boot button at startup)
CONFIG_TINYUSB_MSC_ENABLED=y

# Lower general allocation threshold from 16 KB to 1 KB to route most heap allocations to PSRAM
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=1024
