VIG_API_URL=http://visionlink.local/api
VIG_DEVICE_TOKEN=your_secure_token_here
VIG_HARDWARE_ID=ESP32P4_VISION_LINK_001
VIG_HEARTBEAT_INTERVAL_MS=30000

# Camera & Encoding (optional — defaults match Kconfig)
# Set VIG_USE_MOCK_CAMERA=y for CI/builds without physical hardware
VIG_USE_MOCK_CAMERA=n
VIG_CAMERA_WIDTH=1280
VIG_CAMERA_HEIGHT=720
VIG_ENCODER_BITRATE_KBPS=2000
VIG_ENCODER_GOP=30

# Streaming
VIG_STREAM_PORT=80
VIG_STREAM_MAX_CLIENTS=4
