{
    "C_Cpp.default.cppStandard": "c++23",
    "C_Cpp.default.cStandard": "c17",
    "C_Cpp.intelliSenseEngine": "default",
    "C_Cpp.formatting": "clangFormat",
    "C_Cpp.clang_format_style": "file",
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "ms-vscode.cpptools",
    // Link the Clang-Tidy extension to the compilation database
    "clang-tidy.buildPath": "build",
    "clang-tidy.lintOnSave": true,
    // Ensure the terminal loads your ESP-IDF environment automatically 
    "terminal.integrated.env.linux": {
        "IDF_PATH": "${env:IDF_PATH}"
    },
    "[cmake]": {
        "editor.defaultFormatter": "KylinIdeTeam.cmake-intellisence"
    },
    "idf.currentSetup": "${env:HOME}/.espressif/v6.0.1/esp-idf",
    "cSpell.words": [
        "Psram"
    ],
}