CONFIG_VIGO_HARDWARE_ID="ESP32P4_CAM_GATE"
CONFIG_VIGO_DEVICE_TOKEN="device_token_gate_xyz"
CONFIG_VIGO_API_URL="http://192.168.1.105:8081"

