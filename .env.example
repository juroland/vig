VIGO_API_URL=http://visionlink.local/api
VIGO_DEVICE_TOKEN=your_secure_token_here
VIGO_HARDWARE_ID=ESP32P4_VISION_LINK_001
VIGO_HEARTBEAT_INTERVAL_MS=30000

# Camera & Encoding (optional — defaults match Kconfig)
# Set VIGO_USE_MOCK_CAMERA=y for CI/builds without physical hardware
VIGO_USE_MOCK_CAMERA=n
VIGO_CAMERA_WIDTH=1280
VIGO_CAMERA_HEIGHT=960
VIGO_ENCODER_BITRATE_KBPS=2000
VIGO_ENCODER_GOP=30

# Streaming
VIGO_STREAM_PORT=80
VIGO_STREAM_MAX_CLIENTS=4
